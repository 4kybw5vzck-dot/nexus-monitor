# =============================================================================
# NEXUS Monitor – Konfigurationsvorlage
# Kopieren nach .env und anpassen:   cp .env.example .env
# Die Datei .env enthält später Geheimnisse und wird NIE in Git eingecheckt.
# =============================================================================

# --- Allgemein ---------------------------------------------------------------
# Name des Compose-Projekts (Präfix für Container und Volumes)
COMPOSE_PROJECT_NAME=nexus
# Leer = nur Oberfläche mit Beispieldaten (Mock).
# backend = zusätzlich Backend und Datenbank starten (dann unten
#           NEXUS_DATA_SOURCE=http und POSTGRES_PASSWORD setzen)
COMPOSE_PROFILES=
# Image-Version (für Updates und Rollback)
NEXUS_VERSION=latest
NEXUS_IMAGE_PREFIX=nexus-monitor
# Anzeigename der Instanz in der Oberfläche
NEXUS_INSTANCE_NAME=NEXUS Monitor

# --- Weboberfläche -----------------------------------------------------------
# Netzwerkschnittstelle des Hosts (0.0.0.0 = alle, 127.0.0.1 = nur lokal,
# z. B. hinter einem Reverse-Proxy)
NEXUS_HTTP_BIND=0.0.0.0
NEXUS_HTTP_PORT=8080

# --- Frontend-Build ----------------------------------------------------------
# prebuilt = fertig gebautes Frontend aus frontend/prebuilt verwenden
#            (kein npm, kein Paketdownload – empfohlen für Server)
# source   = im Container aus dem Quellcode bauen (braucht npm-Registry)
NEXUS_FRONTEND_TARGET=prebuilt
# Optional: interner npm-Spiegel für Target "source", z. B. https://npm.firma.local/
NPM_REGISTRY=

# --- Datenquelle des Frontends -----------------------------------------------
# mock = Beispieldaten im Browser, keine Anmeldung
# http = Backend-API mit Anmeldung (braucht COMPOSE_PROFILES=backend)
NEXUS_DATA_SOURCE=mock
# Relativer Pfad empfohlen – das Frontend leitet /api an das Backend weiter
NEXUS_API_BASE_URL=/api

# --- Datenbank (Profil "backend") ---------------------------------------------
TIMESCALEDB_VERSION=latest-pg17
POSTGRES_DB=nexus
POSTGRES_USER=nexus
# Pflicht für das Profil "backend": langes, zufälliges Passwort eintragen
#   z. B. erzeugen mit: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Backend (Profil "backend") ----------------------------------------------
# Erstes Administratorkonto (wird nur angelegt, solange sich niemand anmelden kann).
# Ohne Passwort erzeugt das Backend eines und schreibt es einmalig ins Log:
#   docker compose logs backend | findstr "Erzeugtes Passwort"     (Windows)
#   docker compose logs backend | grep "Erzeugtes Passwort"        (Linux)
NEXUS_ADMIN_LOGIN=admin
NEXUS_ADMIN_PASSWORD=
# Gültigkeit einer Anmeldung in Stunden
NEXUS_SESSION_HOURS=12
# true = Beispieldatensatz (24 Geräte, 30 Tage Verlauf) in eine LEERE Datenbank laden.
# Nur zum Ausprobieren – nicht für den Produktivbetrieb.
NEXUS_SEED_DEMO=false
NEXUS_LOG_LEVEL=INFO
# Optional: interner PyPI-Spiegel für den Bau des Backend-Images
PIP_INDEX_URL=
# Schlüssel für die Verschlüsselung der Zugangsprofile (SNMP-Community,
# Windows-/SSH-Passwörter), mindestens 16 Zeichen, zufällig. NICHT nachträglich
# ändern – sonst müssen alle Zugangsdaten neu eingegeben werden.
# start-nexus.ps1 erzeugt ihn automatisch, wenn er leer ist.
NEXUS_SECRET_KEY=
# Token des zentralen Collectors (mindestens 20 Zeichen, zufällig).
# start-nexus.ps1 erzeugt ihn automatisch, wenn er leer ist.
NEXUS_COLLECTOR_TOKEN=

# --- Datensicherung ----------------------------------------------------------
# Zielverzeichnis für scripts/backup.sh (relativ zum Projektordner oder absolut)
NEXUS_BACKUP_DIR=./backups
# Wie viele Sicherungen aufbewahrt werden
NEXUS_BACKUP_KEEP=14
